{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",

    "paths": {
      "@garage/shared": ["../../packages/shared/src"]
    },

    /* Bun + modern TS expectations */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    /* Quality-of-life */
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
